# Copie este arquivo para .env.local e preencha com as chaves do seu projeto.
# Encontre-as em: Supabase > Project Settings > API Keys
#
# Salve o .env.local em UTF-8. No PowerShell use -Encoding utf8:
# arquivos em UTF-16 fazem o Next.js ler as variaveis com lixo no nome.

# Publicas: vao para o browser, protegidas pelo RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxx

# SECRETA: ignora o RLS por completo. Nunca exponha no browser,
# nunca commite, e use somente em Server Actions / Route Handlers.
# Sem ela a tela /dashboard/usuarios nao consegue criar acessos.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxx

# Opcional: apenas se for usar os recursos de IA.
ANTHROPIC_API_KEY=sua_chave_aqui
